# =================================================================
# ORYON APP - VARIABLES DE ENTORNO
# =================================================================

# Supabase Configuration
VITE_SUPABASE_URL=tu_supabase_url
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# =================================================================
# WOMPI - PASARELA DE PAGOS (COLOMBIA / PSE / TARJETAS / NEQUI)
# =================================================================
# Llave pública de Wompi (frontend)
# Pruebas: pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Producción: pub_prod_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Entorno: 'sandbox' o 'production'
VITE_WOMPI_ENV=sandbox

# Secreto de integridad de Wompi (usado para firmar transacciones SHA-256)
# Pruebas: test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
# Producción: prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx

# =================================================================
# BACKEND / EDGE FUNCTIONS - WOMPI SECRETS (SUPABASE DASHBOARD)
# =================================================================
# Llave privada de Wompi
# Pruebas: prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Producción: prv_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de eventos de Wompi (para validar webhook)
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de integridad (backend)
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
