# =================================================================
# ORYON APP — VARIABLES DE ENTORNO
# =================================================================
# Regla: VITE_* viaja al navegador dentro del bundle. Si un valor no puede
# aparecer en el código fuente que ve un visitante, NO lleva prefijo VITE_.
# Los secretos van en los secretos del Edge Function (supabase secrets set).
# =================================================================

# -----------------------------------------------------------------
# FRONTEND (públicos)
# -----------------------------------------------------------------
# Ojo: aquí va el REF del proyecto, no la URL completa — utils/supabase/client.tsx
# lo interpola como https://${VITE_SUPABASE_URL}.supabase.co
VITE_SUPABASE_URL=tu_project_ref
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Cloudflare Turnstile — clave de SITIO (pública).
# La clave secreta se pega en Supabase → Auth → Attack Protection, no aquí.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_tu_site_key

# Wompi — solo la llave pública y el entorno.
# Pruebas: pub_test_xxxx · Producción: pub_prod_xxxx
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_WOMPI_ENV=sandbox

# -----------------------------------------------------------------
# EDGE FUNCTIONS (secretos — supabase secrets set --env-file)
# -----------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma. Sin esto la API no responde
# a ningún navegador.
# Todos los orígenes desde los que se sirve la app. Si falta el de producción
# —incluido el www— el navegador bloquea TODAS las llamadas a la API.
ALLOWED_ORIGINS=https://oryonsas.com,https://www.oryonsas.com,http://localhost:5173
SITE_URL=https://oryonsas.com

# Resend — envío de los correos de autenticación
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Oryon <acceso@oryonsas.com>

# Secreto del Send Email Hook de Supabase (Auth → Hooks). Formato v1,whsec_...
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Wompi — lo que nunca debe salir del servidor
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_ENVIRONMENT=sandbox
